{
  "schemaVersion": 4,
  "hostApi": 2,
  "server": {
    "host": "127.0.0.1",
    "port": 11434,
    "autoStart": false,
    "apiKey": ""
  },
  "protocol": {
    "routes": {
      "health": "/health",
      "models": "/v1/models",
      "chatCompletions": "/v1/chat/completions",
      "completions": "/v1/completions"
    }
  },
  "hotSettings": {
    "controls": []
  },
  "coreUpdates": {
    "enabled": true,
    "manifestUrl": "https://github.com/CCSSNE/LocalCore/releases/download/core-stable/core-manifest.json",
    "checkIntervalMinutes": 360
  },
  "modelDownloads": {
    "activeSource": "hf-mirror",
    "sources": [
      {
        "id": "huggingface",
        "name": "Hugging Face",
        "endpoint": "https://huggingface.co"
      },
      {
        "id": "hf-mirror",
        "name": "HF-Mirror",
        "endpoint": "https://hf-mirror.com"
      }
    ]
  },
  "diagnostics": {
    "minimumLevel": "info",
    "logcat": true,
    "maxFileBytes": 4194304,
    "retainedFiles": 3
  },
  "management": {
    "sections": [
      {
        "id": "service",
        "title": "服务与更新",
        "fields": [
          {"path": "/server/host", "label": "监听地址", "control": "select", "options": ["127.0.0.1", "0.0.0.0"]},
          {"path": "/server/port", "label": "端口", "control": "number"},
          {"path": "/server/autoStart", "label": "自动启动服务", "control": "toggle"},
          {"path": "/server/apiKey", "label": "Bearer API Key", "control": "text"},
          {"path": "/coreUpdates/enabled", "label": "自动检查核心更新", "control": "toggle"},
          {"path": "/coreUpdates/manifestUrl", "label": "核心 Release 清单 URL", "control": "text"}
        ]
      }
    ]
  },
  "resources": [],
  "models": []
}
